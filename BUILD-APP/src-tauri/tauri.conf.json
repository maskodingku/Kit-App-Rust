{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kit App Rust",
  "version": "1.0.0",
  "identifier": "com.kitapprust.app",
  "build": {
    "frontendDist": "../../ASSETS"
  },
  "app": {
    "windows": [
      {
        "title": "Kit App Rust",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
